@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<h1 class="text-danger">Đã xảy ra lỗi.</h1>
<h2 class="text-danger">Hệ thống chưa xử lý được yêu cầu của bạn.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Chế độ phát triển</h3>
<p>
    Chuyển sang môi trường <strong>Development</strong> sẽ hiển thị thông tin lỗi chi tiết hơn.
</p>
<p>
    <strong>Không nên bật môi trường Development khi triển khai thật.</strong>
    Chế độ này có thể hiển thị thông tin nhạy cảm từ ngoại lệ cho người dùng cuối.
</p>
