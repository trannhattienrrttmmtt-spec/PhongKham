<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phòng Khám An Tâm</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PhongKham.styles.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var isAdmin = User.IsInRole("Admin");
    var isDoctor = User.IsInRole("BacSi");
    var isPharmacist = User.IsInRole("DuocSi");
    var isPatient = User.IsInRole("BenhNhan");
    var displayName = User.Identity?.Name ?? "User";
    var avatarInitial = displayName.Trim().Length > 0 ? displayName.Trim()[0] : 'U';
    var roleText = isAdmin ? "Admin" : isDoctor ? "Bác sĩ" : isPharmacist ? "Dược sĩ" : isPatient ? "Bệnh nhân" : "Người dùng";

    <div class="app-frame">
        <aside class="clinic-sidebar">
            <a class="brand-block" asp-controller="@(isPatient ? "PatientPortal" : "Clinic")" asp-action="@(isPatient ? "Home" : "Dashboard")">
                <span class="brand-mark"><i class="bi bi-hospital"></i></span>
                <span>
                    <strong>An Tam Clinic</strong>
                    <small>Quản lý phòng khám</small>
                </span>
            </a>

            <nav class="side-nav">
                @if (isPatient)
                {
                    <a asp-controller="PatientPortal" asp-action="Home" class="@(currentAction == "Home" ? "active" : "")"><i class="nav-icon bi bi-house-heart-fill"></i><span class="nav-label">Trang chủ</span></a>
                    <a asp-controller="PatientPortal" asp-action="Book"><i class="nav-icon bi bi-calendar-plus-fill"></i><span class="nav-label">Đặt lịch khám</span></a>
                    <a asp-controller="PatientPortal" asp-action="Appointments" class="@(currentAction is "Appointments" or "AppointmentDetail" or "EditAppointment" ? "active" : "")"><i class="nav-icon bi bi-calendar3"></i><span class="nav-label">Lịch khám</span></a>
                    <a asp-controller="PatientPortal" asp-action="Results" class="@(currentAction is "Results" or "ResultDetail" ? "active" : "")"><i class="nav-icon bi bi-clipboard2-pulse-fill"></i><span class="nav-label">Hồ sơ khám & thuốc</span></a>
                    <a asp-controller="PatientPortal" asp-action="Payments"><i class="nav-icon bi bi-qr-code"></i><span class="nav-label">Thanh toán</span></a>
                }
                else
                {
                    <a asp-controller="Clinic" asp-action="Dashboard" class="@(currentAction == "Dashboard" ? "active" : "")"><i class="nav-icon bi bi-grid-1x2-fill"></i><span class="nav-label">Trang chủ</span></a>

                    @if (isAdmin || isDoctor)
                    {
                        <a asp-controller="Clinic" asp-action="Patients" class="@(currentAction == "Patients" ? "active" : "")"><i class="nav-icon bi bi-people-fill"></i><span class="nav-label">Bệnh nhân</span></a>
                    }
                    @if (isAdmin)
                    {
                        <a asp-controller="Clinic" asp-action="Doctors" class="@(currentAction == "Doctors" ? "active" : "")"><i class="nav-icon bi bi-person-badge-fill"></i><span class="nav-label">Bác sĩ</span></a>
                    }
                    @if (isAdmin || isDoctor)
                    {
                        <a asp-controller="Clinic" asp-action="Appointments" class="@(currentAction == "Appointments" ? "active" : "")"><i class="nav-icon bi bi-calendar3"></i><span class="nav-label">Lịch hẹn</span></a>
                    }
                    @if (isAdmin || isPharmacist)
                    {
                        <a asp-controller="Clinic" asp-action="Medicines" class="@(currentAction is "Medicines" or "InventoryReceipts" or "InventoryLots" or "InventoryTransactions" or "ExpiryAlerts" ? "active" : "")"><i class="nav-icon bi bi-capsule"></i><span class="nav-label">Kho thuốc</span></a>
                        @if (isPharmacist && !isAdmin)
                        {
                            <a asp-controller="Clinic" asp-action="InventoryReceipts" class="@(currentAction == "InventoryReceipts" ? "active" : "")"><i class="nav-icon bi bi-box-arrow-in-down"></i><span class="nav-label">Phiếu nhập</span></a>
                            <a asp-controller="Clinic" asp-action="InventoryLots" class="@(currentAction == "InventoryLots" ? "active" : "")"><i class="nav-icon bi bi-boxes"></i><span class="nav-label">Lô thuốc</span></a>
                            <a asp-controller="Clinic" asp-action="InventoryTransactions" class="@(currentAction == "InventoryTransactions" ? "active" : "")"><i class="nav-icon bi bi-clock-history"></i><span class="nav-label">Lịch sử kho</span></a>
                            <a asp-controller="Clinic" asp-action="ExpiryAlerts" class="@(currentAction == "ExpiryAlerts" ? "active" : "")"><i class="nav-icon bi bi-exclamation-octagon-fill"></i><span class="nav-label">Cảnh báo hạn</span></a>
                        }
                    }
                    @if (isAdmin || isDoctor || isPharmacist)
                    {
                        <a asp-controller="Clinic" asp-action="Prescriptions" class="@(currentAction == "Prescriptions" ? "active" : "")"><i class="nav-icon bi bi-file-earmark-medical-fill"></i><span class="nav-label">Đơn thuốc</span></a>
                    }
                    @if (isAdmin || isDoctor)
                    {
                        <a asp-controller="Clinic" asp-action="MedicalRecords" class="@(currentAction == "MedicalRecords" ? "active" : "")"><i class="nav-icon bi bi-journal-medical"></i><span class="nav-label">Bệnh án</span></a>
                    }
                    @if (isAdmin)
                    {
                        <a asp-controller="Clinic" asp-action="Revenue" class="@(currentAction == "Revenue" ? "active" : "")"><i class="nav-icon bi bi-graph-up-arrow"></i><span class="nav-label">Doanh thu</span></a>
                        <a asp-controller="AdminPatientPortal" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminPatientPortal" ? "active" : "")"><i class="nav-icon bi bi-person-lines-fill"></i><span class="nav-label">Cổng bệnh nhân</span></a>
                        <a asp-controller="Clinic" asp-action="Users" class="@(currentAction == "Users" ? "active" : "")"><i class="nav-icon bi bi-person-gear"></i><span class="nav-label">Tài khoản</span></a>
                    }
                }
            </nav>


        </aside>

        <div class="content-frame">
            <header class="topbar">
                <div class="topbar-title-block">
                    <h1>@ViewData["Title"]</h1>
                    @if (ViewData["Subtitle"] is string subtitle && !string.IsNullOrEmpty(subtitle))
                    {
                        <p class="topbar-subtitle">@subtitle</p>
                    }
                </div>
                <div class="topbar-right-block">
                    @if (isPatient)
                    {
                        <a class="topbar-icon-btn" asp-controller="PatientPortal" asp-action="Notifications" title="Thông báo">
                            <i class="bi bi-bell-fill"></i>
                        </a>
                    }
                    <div class="operator-menu dropdown">
                        <button class="operator-chip operator-avatar-chip @(isPatient ? "patient-account-chip" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Tài khoản">
                            <span class="topbar-avatar">@avatarInitial</span>
                            <span class="operator-info">
                                <span class="operator-name">@displayName</span>
                                <span class="operator-role">@roleText</span>
                            </span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end account-dropdown">
                            @if (isPatient)
                            {
                                <a class="dropdown-item" asp-controller="PatientPortal" asp-action="Profile"><i class="bi bi-person-vcard"></i> Hồ sơ cá nhân</a>
                            }
                            <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                                <button type="submit" class="dropdown-item logout-menu-item">
                                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <main role="main" class="app-shell">
                @if (TempData["DatabaseWarning"] is string databaseWarning)
                {
                    <div class="alert alert-warning database-alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@databaseWarning</span>
                    </div>
                }
                <div class="fade-in-content">
                    @RenderBody()
                </div>
            </main>
            @if (isPatient)
            {
                <div class="floating-chat" data-floating-chat>
                    <button class="floating-chat-button" type="button" data-chat-toggle aria-expanded="false" title="Chat hỗ trợ">
                        <i class="bi bi-chat-dots-fill"></i>
                    </button>
                    <section class="floating-chat-panel" hidden>
                        <header>
                            <div>
                                <strong>Trợ lý AI An Tâm</strong>
                                <span>Hỗ trợ nhanh, không lưu hội thoại</span>
                            </div>
                            <button type="button" data-chat-close aria-label="Đóng chat"><i class="bi bi-x-lg"></i></button>
                        </header>
                        <div class="floating-chat-messages" data-floating-chat-messages>
                            <div class="message incoming"><p>Xin chào, tôi có thể hỗ trợ bạn đặt lịch, thanh toán QR và chuẩn bị trước khi khám.</p><small>AI</small></div>
                        </div>
                        <form asp-controller="PatientPortal" asp-action="SendChatMessage" method="post" class="floating-chat-composer" data-floating-chat-form>
                            @Html.AntiForgeryToken()
                            <input name="message" autocomplete="off" placeholder="Nhập câu hỏi..." />
                            <button type="submit" title="Gửi"><i class="bi bi-send-fill"></i></button>
                        </form>
                    </section>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="public-frame">
        <header class="public-nav">
            <a class="public-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-hospital"></i></span>
                <span>
                    <strong>An Tam Clinic</strong>
                    <small>Chăm sóc sức khỏe mỗi ngày</small>
                </span>
            </a>
            <nav>
                <a asp-controller="Home" asp-action="Index">Giới thiệu</a>
                <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Đăng ký khám</a>
            </nav>
        </header>
        <main role="main" class="public-shell">
            @RenderBody()
        </main>
    </div>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
