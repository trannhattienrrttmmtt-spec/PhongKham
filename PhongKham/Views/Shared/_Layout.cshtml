<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phong Kham</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PhongKham.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg clinic-nav">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Clinic" asp-action="Dashboard">Phong Kham An Tam</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav flex-grow-1 gap-lg-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Clinic" asp-action="Dashboard">Trang chu</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Clinic" asp-action="Patients">Benh nhan</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Clinic" asp-action="Doctors">Bac si</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Clinic" asp-action="Rooms">Phong benh</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Clinic" asp-action="Appointments">Lich hen</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Clinic" asp-action="Medicines">Kho thuoc</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Clinic" asp-action="Prescriptions">Don thuoc</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Clinic" asp-action="MedicalRecords">Benh an</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Clinic" asp-action="Revenue">Doanh thu</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Clinic" asp-action="Users">Phan quyen</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid app-shell">
        <main role="main" class="pb-3">
            @if (TempData["DatabaseWarning"] is string databaseWarning)
            {
                <div class="alert alert-warning">@databaseWarning</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container">
            &copy; 2026 - He thong quan ly phong kham
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
