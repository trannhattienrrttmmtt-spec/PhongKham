                        {
                            <option value="@doctor.Id">@doctor.FullName</option>
                        }
                    </select>
                }
                else
                {
                    <input class="form-control" value="@Model.CurrentDoctor?.FullName" readonly />
                    <input class="form-control" value="@(Model.SelectedPatient?.FullName ?? "Bá»‡nh nhÃ¢n tá»« lá»‹ch háº¹n")" readonly />
                }

                <input asp-for="Form.Diagnosis" class="form-control" placeholder="Cháº©n Ä‘oÃ¡n" />
                <textarea asp-for="Form.Instructions" class="form-control wide" rows="3" placeholder="Dáº·n dÃ² thÃªm cho bá»‡nh nhÃ¢n"></textarea>
            </div>

            <div class="table-responsive mt-3">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Thuá»‘c</th>
                            <th>Sá»‘ lÆ°á»£ng</th>
                            <th>Liá»u dÃ¹ng</th>
                            <th>ÄÆ°á»ng dÃ¹ng</th>
                            <th>HÆ°á»›ng dáº«n sá»­ dá»¥ng</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Form.Items.Count; i++)
                    {
                        <tr>
                            <td>
                                <select asp-for="Form.Items[i].MedicineId" class="form-select">
                                    <option value="">Chá»n thuá»‘c</option>
                                    @foreach (var medicine in Model.Medicines)
                                    {
                                        <option value="@medicine.Id">@medicine.Name (@medicine.QuantityInStock @medicine.Unit)</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input asp-for="Form.Items[i].Quantity" class="form-control" type="number" min="0" />
                            </td>
                            <td>
                                <input asp-for="Form.Items[i].Dosage" class="form-control" placeholder="VÃ­ dá»¥: 1 viÃªn x 2 láº§n/ngÃ y" />
                            </td>
                            <td>
                                <input asp-for="Form.Items[i].Route" class="form-control" placeholder="VÃ­ dá»¥: Uá»‘ng / SÃºc há»ng" />
                            </td>
                            <td>
                                <input asp-for="Form.Items[i].UsageInstruction" class="form-control" placeholder="VÃ­ dá»¥: Sau Äƒn sÃ¡ng vÃ  tá»‘i" />
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">@(Model.Form.IsEditing ? "LÆ°u cáº­p nháº­t" : "LÆ°u Ä‘Æ¡n thuá»‘c")</button>
                @if (Model.Form.IsEditing)
                {
                    <a class="btn btn-outline-primary" asp-action="Prescriptions">KÃª Ä‘Æ¡n má»›i</a>
                }
            </div>
        </form>
    </div>
}

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Kiá»ƒm tra tá»“n kho vÃ  an toÃ n thuá»‘c</h2>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Thuá»‘c</th>
                    <th>Tá»“n kho</th>
                    <th>Háº¡n dÃ¹ng</th>
                    <th>ÄÆ¡n giÃ¡</th>
                    <th>Ghi chÃº</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var medicine in Model.MedicineChecks)
            {
                <tr>
                    <td><strong>@medicine.Name</strong></td>
                    <td>@medicine.QuantityInStock @medicine.Unit</td>
                    <td>@medicine.ExpiryDate.ToString("dd/MM/yyyy")</td>
                    <td>@medicine.UnitPrice.ToString("N0") &#273;</td>
                    <td>
                        <span class="badge @(medicine.IsExpired || medicine.HasAllergyWarning ? "bg-danger" : medicine.IsLowStock ? "bg-warning text-dark" : "bg-success")">
                            @medicine.Note
                        </span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Danh sÃ¡ch Ä‘Æ¡n thuá»‘c</h2>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>NgÃ y láº­p</th>
                    <th>Lá»‹ch háº¹n</th>
                    <th>Bá»‡nh nhÃ¢n</th>
                    <th>BÃ¡c sÄ©</th>
                    <th>Cháº©n Ä‘oÃ¡n</th>
                    <th>Thuá»‘c chi tiáº¿t</th>
                    <th>Tá»•ng tiá»n</th>
                    <th>Thao tÃ¡c</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var prescription in Model.Prescriptions)
            {
                <tr>
                    <td>@prescription.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (prescription.AppointmentId.HasValue && prescription.Appointment is not null)
                        {
                            <span>#@prescription.AppointmentId - @prescription.Appointment.AppointmentTime.ToString("dd/MM/yyyy HH:mm")</span>
                        }
                        else
                        {
                            <span class="text-muted">ChÆ°a gáº¯n lá»‹ch háº¹n</span>
                        }
                    </td>
                    <td><strong>@prescription.Patient?.FullName</strong></td>
                    <td>@prescription.Doctor?.FullName</td>
                    <td>
                        <div><strong>@prescription.Diagnosis</strong></div>
                        <div class="text-muted">@prescription.Instructions</div>
                    </td>
                    <td>
                        @if (prescription.Details.Count == 0)
                        {
                            <span class="text-muted">ChÆ°a cÃ³ thuá»‘c chi tiáº¿t</span>
                        }
                        else
                        {
                            foreach (var detail in prescription.Details)
                            {
                                <div class="mb-2">
                                    <strong>@detail.Medicine?.Name</strong>
                                    - @detail.Quantity @detail.Medicine?.Unit
                                    <br />
                                    <span class="text-muted">@detail.Dosage | @detail.Route | @detail.UsageInstruction</span>
                                </div>
                            }
                        }
                    </td>
                    <td>@prescription.TotalAmount.ToString("N0") &#273;</td>
                    <td>
                        @{
                            var statusLabel = prescription.DispenseStatus == "Dispensed"
                                ? "Da cap"
                                : prescription.DispenseStatus == "Rejected"
                                    ? "Tu choi"
                                    : "Cho cap";
                        }
                        <span class="badge @(prescription.DispenseStatus == "Rejected" ? "bg-danger" : prescription.DispenseStatus == "Dispensed" ? "bg-success" : "bg-warning text-dark")">@statusLabel</span>
                        @if (prescription.DispensedAt is not null)
                        {
                            <div class="text-muted">@prescription.DispensedAt.Value.ToString("dd/MM HH:mm")</div>
                        }
                        <div class="d-flex flex-column gap-2">
                            @if (canEdit)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="Prescriptions" asp-route-editId="@prescription.Id">Sua</a>
                                <form asp-action="DeletePrescription" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@prescription.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xoa</button>
                                </form>
                            }
                            @if (canDispense && prescription.DispenseStatus == "Pending")
                            {
                                <form asp-action="DispensePrescription" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@prescription.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary">Cap thuoc</button>
                                </form>
                                <form asp-action="RejectPrescription" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@prescription.Id" />
                                    <input type="hidden" name="note" value="Tu choi cap thuoc" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Tu choi</button>
                                </form>
                            }
                            @if (!canEdit && (!canDispense || prescription.DispenseStatus != "Pending"))
                            {
                                <span class="text-muted">Duoc si theo doi cap phat</span>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
