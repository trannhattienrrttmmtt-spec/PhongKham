@model List<Prescription>
@{
    ViewData["Title"] = "Đơn thuốc";
    var patients = (List<Patient>)ViewBag.Patients;
    var doctors = (List<Doctor>)ViewBag.Doctors;
}

<div class="page-title">
    <div>
        <h1>Đơn thuốc</h1>
        <div class="text-muted">Lập đơn, ghi chẩn đoán và theo dõi hướng dẫn dùng thuốc.</div>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Lập đơn thuốc</h2>
            <p>Thông tin đơn thuốc sẽ được dùng cho dược sĩ cấp phát.</p>
        </div>
    </div>
    <form asp-action="AddPrescription" method="post" class="form-grid">
        <select name="PatientId" class="form-select">@foreach (var p in patients){<option value="@p.Id">@p.FullName</option>}</select>
        <select name="DoctorId" class="form-select">@foreach (var d in doctors){<option value="@d.Id">@d.FullName</option>}</select>
        <input name="Diagnosis" class="form-control" placeholder="Chẩn đoán" />
        <input name="TotalAmount" type="number" class="form-control" placeholder="Tổng tiền" />
        <textarea name="Instructions" class="form-control wide" placeholder="Hướng dẫn sử dụng"></textarea>
        <button class="btn btn-primary">Lưu đơn thuốc</button>
    </form>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Danh sách đơn thuốc</h2>
            <p>@Model.Count đơn thuốc đã lập.</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Ngày lập</th><th>Bệnh nhân</th><th>Bác sĩ</th><th>Chẩn đoán</th><th>Hướng dẫn</th><th>Tổng tiền</th></tr></thead>
            <tbody>
            @foreach (var x in Model)
            {
                <tr><td>@x.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@x.Patient?.FullName</strong></td><td>@x.Doctor?.FullName</td><td>@x.Diagnosis</td><td>@x.Instructions</td><td>@x.TotalAmount.ToString("N0") &#273;</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
