            <div class="form-grid">
                <select asp-for="Form.AppointmentId" class="form-select">
                    <option value="">Chá»n lá»‹ch háº¹n</option>
                    @foreach (var appointment in Model.AvailableAppointments)
                    {
                        <option value="@appointment.Id">
                            @appointment.AppointmentTime.ToString("dd/MM/yyyy HH:mm") - @appointment.Patient?.FullName - @appointment.Doctor?.FullName
                        </option>
                    }
                </select>

                @if (Model.SelectedAppointment is not null)
                {
                    <div class="wide alert alert-info">
                        #@Model.SelectedAppointment.Id - @Model.SelectedAppointment.AppointmentTime.ToString("dd/MM/yyyy HH:mm") - @Model.SelectedAppointment.Patient?.FullName
                    </div>
                }

                @if (Model.SelectedPatient is not null)
                {
                    <div class="wide alert @(string.IsNullOrWhiteSpace(Model.SelectedPatient.AllergyNotes) ? "alert-secondary" : "alert-warning")">
                        <strong>Dá»‹ á»©ng:</strong>
                        @(string.IsNullOrWhiteSpace(Model.SelectedPatient.AllergyNotes) ? "ChÆ°a cÃ³ cáº£nh bÃ¡o dá»‹ á»©ng." : Model.SelectedPatient.AllergyNotes)
                    </div>
                }

                @if (!Model.IsDoctor)
