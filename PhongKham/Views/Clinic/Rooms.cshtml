@model List<Room>
@{ ViewData["Title"] = "Phòng bệnh"; }

<div class="page-title">
    <div>
        <h1>Phòng bệnh</h1>
        <div class="text-muted">Theo dõi sức chứa, giường đang dùng và trạng thái từng phòng.</div>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Thêm phòng</h2>
            <p>Khai báo phòng khám, phòng điều trị hoặc phòng nội trú.</p>
        </div>
    </div>
    <form asp-action="AddRoom" method="post" class="form-grid">
        <input name="RoomNumber" class="form-control" placeholder="Số phòng" required />
        <input name="Department" class="form-control" placeholder="Khoa/phong ban" />
        <input name="Capacity" type="number" class="form-control" placeholder="Sức chứa" value="1" />
        <input name="OccupiedBeds" type="number" class="form-control" placeholder="Giường đang dùng" value="0" />
        <select name="Status" class="form-select"><option>Sẵn sàng</option><option>Đầy phòng</option><option>Bảo trì</option><option>Ưu tiên</option></select>
        <button class="btn btn-primary">Lưu phòng</button>
    </form>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Tình trạng phòng</h2>
            <p>Cân bằng phòng trống và phòng đang sử dụng.</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Phòng</th><th>Khoa</th><th>Sức chứa</th><th>Đang dùng</th><th>Còn trống</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach (var x in Model)
            {
                <tr><td><strong>@x.RoomNumber</strong></td><td>@x.Department</td><td>@x.Capacity</td><td>@x.OccupiedBeds</td><td>@(x.Capacity - x.OccupiedBeds)</td><td><span class="badge badge-soft">@x.Status</span></td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
