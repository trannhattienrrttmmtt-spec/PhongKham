@{ ViewData["Title"] = "Báo cáo doanh thu"; }

<div class="page-title">
    <div>
        <h1>Báo cáo doanh thu</h1>
        <div class="text-muted">Tổng hợp tiền khám, tiền thuốc và giao dịch gần đây.</div>
    </div>
</div>

<div class="metric-grid">
    <div class="metric accent-blue"><span>Doanh thu khám bệnh</span><strong>@(((decimal)ViewBag.AppointmentRevenue).ToString("N0")) &#273;</strong></div>
    <div class="metric accent-green"><span>Doanh thu đơn thuốc</span><strong>@(((decimal)ViewBag.PrescriptionRevenue).ToString("N0")) &#273;</strong></div>
    <div class="metric accent-rose"><span>Tổng doanh thu</span><strong>@(((decimal)ViewBag.TotalRevenue).ToString("N0")) &#273;</strong></div>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Giao dịch gần đây</h2>
            <p>Các khoản thu mới nhất đã được ghi nhận trong hệ thống.</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Nguồn</th><th>Ngày</th><th>Bệnh nhân</th><th>Số tiền</th></tr></thead>
            <tbody>
            @foreach (Appointment x in ViewBag.Appointments)
            {
                <tr><td>Phí khám</td><td>@x.AppointmentTime.ToString("dd/MM/yyyy")</td><td>@x.Patient?.FullName</td><td>@x.Fee.ToString("N0") &#273;</td></tr>
            }
            @foreach (Prescription x in ViewBag.Prescriptions)
            {
                <tr><td>Đơn thuốc</td><td>@x.CreatedAt.ToString("dd/MM/yyyy")</td><td>@x.Patient?.FullName</td><td>@x.TotalAmount.ToString("N0") &#273;</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
