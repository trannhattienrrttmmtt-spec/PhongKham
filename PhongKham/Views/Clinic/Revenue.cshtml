@{
    ViewData["Title"] = "Báo cáo doanh thu";
    ViewData["Subtitle"] = "Tổng hợp tiền khám, tiền thuốc và giao dịch gần đây.";
    var invoices = (List<Invoice>)ViewBag.Invoices;
    var from = (DateTime)ViewBag.From;
    var to = (DateTime)ViewBag.To;
}

<div class="panel compact-panel">
    <form asp-action="Revenue" method="get" class="admin-filter-bar">
        <label><span>Từ ngày</span><input name="from" type="date" value="@from.ToString("yyyy-MM-dd")" class="form-control" /></label>
        <label><span>Đến ngày</span><input name="to" type="date" value="@to.ToString("yyyy-MM-dd")" class="form-control" /></label>
        <button class="btn btn-primary">Xem báo cáo</button>
        <a class="btn btn-outline-primary" asp-action="ExportRevenue" asp-route-from="@from.ToString("yyyy-MM-dd")" asp-route-to="@to.ToString("yyyy-MM-dd")">Xuất CSV</a>
    </form>
</div>

<div class="metric-grid">
    <div class="metric accent-blue"><span>Doanh thu khám bệnh</span><strong>@(((decimal)ViewBag.AppointmentRevenue).ToString("N0")) &#273;</strong></div>
    <div class="metric accent-green"><span>Doanh thu đơn thuốc</span><strong>@(((decimal)ViewBag.PrescriptionRevenue).ToString("N0")) &#273;</strong></div>
    <div class="metric accent-rose"><span>Tổng doanh thu</span><strong>@(((decimal)ViewBag.TotalRevenue).ToString("N0")) &#273;</strong></div>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Hóa đơn đã thanh toán</h2>
            <p>Từ @from.ToString("dd/MM/yyyy") đến @to.ToString("dd/MM/yyyy").</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Mã hóa đơn</th><th>Ngày thanh toán</th><th>Bệnh nhân</th><th>Khám</th><th>Thuốc</th><th>Tổng tiền</th><th>Phương thức</th></tr></thead>
            <tbody>
            @foreach (var invoice in invoices)
            {
                var payment = invoice.Payments.OrderByDescending(x => x.PaidAt).First();
                <tr><td><strong>@invoice.InvoiceCode</strong></td><td>@payment.PaidAt.ToString("dd/MM/yyyy HH:mm")</td><td>@invoice.Patient?.FullName</td><td>@invoice.ExaminationFee.ToString("N0") đ</td><td>@invoice.MedicineFee.ToString("N0") đ</td><td><strong>@invoice.TotalAmount.ToString("N0") đ</strong></td><td>@payment.Method</td></tr>
            }
            @if (!invoices.Any())
            {
                <tr><td colspan="7" class="text-center text-muted">Không có giao dịch đã thanh toán trong khoảng ngày này.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
