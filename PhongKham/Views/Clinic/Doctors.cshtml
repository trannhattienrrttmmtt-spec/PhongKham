@model List<Doctor>
@{
    ViewData["Title"] = "Bác sĩ";
    ViewData["Subtitle"] = "Quản lý hồ sơ bác sĩ và tài khoản đăng nhập theo role BacSi.";
}

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Thêm bác sĩ và tài khoản</h2>
            <p>Email bên dưới sẽ được gắn vào hồ sơ bác sĩ để đăng nhập và chỉ xem lịch khám của chính bác sĩ đó.</p>
        </div>
    </div>

    <form asp-action="AddDoctor" method="post" class="form-grid">
        <input name="FullName" class="form-control" placeholder="Họ tên bác sĩ" required />
        <input name="Specialty" class="form-control" placeholder="Chuyên khoa" />
        <input name="Phone" class="form-control" placeholder="Điện thoại" />
        <select name="Status" class="form-select">
            <option value="Đang làm việc">Đang làm việc</option>
            <option value="Nghỉ phép">Nghỉ phép</option>
            <option value="Tạm ngưng">Tạm ngưng</option>
        </select>
        <input name="email" type="email" class="form-control" placeholder="Email đăng nhập bác sĩ" required />
        <input name="password" type="text" class="form-control" placeholder="Mật khẩu ban đầu, ví dụ Dev@123456" value="Dev@123456" required />
        <button class="btn btn-primary">Tạo bác sĩ và tài khoản</button>
    </form>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Bác sĩ hiện có</h2>
            <p>@Model.Count bác sĩ trong danh sách.</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Chuyên khoa</th>
                    <th>Điện thoại</th>
                    <th>Tài khoản</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var doctor in Model)
            {
                <tr>
                    <td><strong>@doctor.FullName</strong></td>
                    <td>@doctor.Specialty</td>
                    <td>@doctor.Phone</td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(doctor.AccountEmail))
                        {
                            <span class="badge badge-warn">Chưa liên kết</span>
                        }
                        else
                        {
                            <span>@doctor.AccountEmail</span>
                        }
                    </td>
                    <td><span class="badge badge-soft">@doctor.Status</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
