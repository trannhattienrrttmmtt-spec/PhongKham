@model ClinicDashboardViewModel
@{
    ViewData["Title"] = "Trang chủ";
    var isAdmin = User.IsInRole("Admin");
    var isDoctor = User.IsInRole("BacSi");
    var isPharmacist = User.IsInRole("DuocSi");
    var isPatient = User.IsInRole("BenhNhan");
    var roleName = isAdmin ? "quản trị viên"
        : isDoctor ? "bác sĩ"
        : isPharmacist ? "dược sĩ"
        : isPatient ? "bệnh nhân"
        : "người dùng";
}

<section class="welcome-panel role-welcome">
    <div>
        <span class="eyebrow">Xin chào @roleName</span>
        @if (isAdmin)
        {
            <h1>Bảng điều hành phòng khám</h1>
        }
        else if (isDoctor)
        {
            <h1>Không gian làm việc của bác sĩ</h1>
        }
        else if (isPharmacist)
        {
            <h1>Khu vực dược sĩ</h1>
        }
        else
        {
            <h1>Cổng bệnh nhân</h1>
        }
    </div>

    <div class="page-actions">
        @if (isAdmin)
        {
            <a class="btn btn-primary" asp-action="Revenue">Xem doanh thu</a>
            <a class="btn btn-outline-primary" asp-action="Doctors">Quản lý bác sĩ</a>
        }
        else if (isDoctor)
        {
            <a class="btn btn-primary" asp-action="MedicalRecords">Tạo bệnh án</a>
            <a class="btn btn-outline-primary" asp-action="Prescriptions">Lập đơn thuốc</a>
        }
        else if (isPharmacist)
        {
            <a class="btn btn-primary" asp-action="Prescriptions">Xem đơn thuốc</a>
            <a class="btn btn-outline-primary" asp-action="Medicines">Nhập thuốc</a>
        }
        else
        {
            <a class="btn btn-primary" asp-action="Appointments">Đặt lịch khám</a>
        }
    </div>
</section>

<div class="metric-grid friendly-metrics">
    @if (isAdmin)
    {
        <div class="metric accent-teal"><span>Bệnh nhân</span><strong>@Model.Patients</strong></div>
        <div class="metric accent-blue"><span>Bác sĩ</span><strong>@Model.Doctors</strong></div>
        <div class="metric accent-green"><span>Lịch hẹn hôm nay</span><strong>@Model.AppointmentsToday</strong></div>
        <div class="metric accent-amber"><span>Thuốc cần bổ sung</span><strong>@Model.LowStockMedicines</strong></div>
        <div class="metric accent-rose"><span>Doanh thu tháng</span><strong>@Model.RevenueThisMonth.ToString("N0") &#273;</strong></div>
    }
    else if (isDoctor)
    {
        <div class="metric accent-green"><span>Lịch khám hôm nay</span><strong>@Model.AppointmentsToday</strong></div>
        <div class="metric accent-teal"><span>Bệnh nhân phụ trách</span><strong>@Model.Patients</strong></div>
        <div class="metric accent-blue"><span>Đơn thuốc đã lập</span><strong>@Model.PrescriptionsCount</strong></div>
    }
    else if (isPharmacist)
    {
        <div class="metric accent-amber"><span>Thuốc sắp hết</span><strong>@Model.LowStockMedicines</strong></div>
        <div class="metric accent-green"><span>Đơn thuốc chờ cấp</span><strong>@Model.UpcomingAppointments.Count</strong></div>
    }
    else
    {
        <div class="metric accent-green"><span>Lịch hẹn hôm nay</span><strong>@Model.AppointmentsToday</strong></div>
        <div class="metric accent-teal"><span>Lịch sắp tới</span><strong>@Model.UpcomingAppointments.Count</strong></div>
    }
</div>

<div class="dashboard-grid">
    <div class="panel">
        <div class="panel-head">
            <div>
                @if (isPharmacist)
                {
                    <h2>Đơn thuốc cần theo dõi</h2>
                }
                else if (isPatient)
                {
                    <h2>Lịch hẹn của bạn</h2>
                }
                else if (isDoctor)
                {
                    <h2>Lịch khám của bác sĩ</h2>
                }
                else
                {
                    <h2>Lịch hẹn sắp tới</h2>
                }
            </div>

            @if (!isPharmacist)
            {
                <a asp-action="Appointments">Mở lịch hẹn</a>
            }
            else
            {
                <a asp-action="Prescriptions">Mở đơn thuốc</a>
            }
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th>Bệnh nhân</th>
                        <th>Bác sĩ</th>
                        <th>Lý do</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.UpcomingAppointments)
                {
                    <tr>
                        <td>@item.AppointmentTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><strong>@item.Patient?.FullName</strong></td>
                        <td>@item.Doctor?.FullName</td>
                        <td>@item.Reason</td>
                        <td><span class="badge badge-soft">@item.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="panel compact-panel">
        <div class="panel-head">
            <div>
                <h2>Việc cần làm</h2>
            </div>
        </div>

        <div class="ops-list">
            @if (isAdmin)
            {
                <a asp-action="Patients"><span>Bệnh nhân</span><strong>Mở danh sách hồ sơ</strong></a>
                <a asp-action="Appointments"><span>Lịch hẹn</span><strong>Xử lý lịch trong ngày</strong></a>
                <a asp-action="Revenue"><span>Doanh thu</span><strong>Xem báo cáo tổng hợp</strong></a>
            }
            else if (isDoctor)
            {
                <a asp-action="Appointments"><span>Lịch khám</span><strong>Xem đúng lịch của mình</strong></a>
                <a asp-action="MedicalRecords"><span>Bệnh án</span><strong>Tạo và chỉnh sửa hồ sơ khám</strong></a>
                <a asp-action="Prescriptions"><span>Đơn thuốc</span><strong>Kê toa chi tiết từng thuốc</strong></a>
            }
            else if (isPharmacist)
            {
                <a asp-action="Prescriptions"><span>Đơn thuốc</span><strong>Kiểm tra trước khi cấp phát</strong></a>
                <a asp-action="Medicines"><span>Kho thuốc</span><strong>Cập nhật tồn kho</strong></a>
            }
            else
            {
                <a asp-action="Appointments"><span>Đặt lịch</span><strong>Chọn bác sĩ và thời gian khám</strong></a>
                <a asp-action="Appointments"><span>Lịch của tôi</span><strong>Theo dõi trạng thái hẹn khám</strong></a>
            }
        </div>
    </div>
</div>
