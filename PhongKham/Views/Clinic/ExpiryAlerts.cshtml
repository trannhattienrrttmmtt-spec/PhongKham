@model List<Medicine>
@{
    ViewData["Title"] = "Cảnh báo hết hạn";
    var expired = Model.Count(x => x.ExpiryDate.Date < DateTime.Today);
    var in30 = Model.Count(x => x.ExpiryDate.Date >= DateTime.Today && x.ExpiryDate.Date <= DateTime.Today.AddDays(30));
    var in90 = Model.Count(x => x.ExpiryDate.Date > DateTime.Today.AddDays(30) && x.ExpiryDate.Date <= DateTime.Today.AddDays(90));
}

<div class="page-title pharmacist-page-title">
    <div>
        <span class="eyebrow">An toàn kho thuốc</span>
        <h1>Cảnh báo hết hạn</h1>
        <div class="text-muted">Ưu tiên xử lý thuốc đã hết hạn, sắp hết hạn 30 ngày và nhóm cần theo dõi.</div>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Medicines">Mở kho thuốc</a>
    </div>
</div>

<section class="pharmacy-command-grid medicine-kpis">
    <div class="pharmacy-stat accent-rose"><span>Đã hết hạn</span><strong>@expired</strong><small>Ngừng cấp phát</small></div>
    <div class="pharmacy-stat accent-amber"><span>Trong 30 ngày</span><strong>@in30</strong><small>Cần xử lý sớm</small></div>
    <div class="pharmacy-stat accent-blue"><span>Trong 90 ngày</span><strong>@in90</strong><small>Theo dõi ưu tiên</small></div>
    <div class="pharmacy-stat accent-teal"><span>Tổng cảnh báo</span><strong>@Model.Count</strong><small>Trong 6 tháng</small></div>
</section>

<section class="panel pharmacy-panel">
    <div class="panel-head pharmacy-toolbar-head">
        <div>
            <h2>Danh sách thuốc cần kiểm soát hạn dùng</h2>
            <p>Màu cảnh báo thay đổi theo số ngày còn lại.</p>
        </div>
        <div class="pharmacy-toolbar">
            <input id="expirySearch" class="form-control" placeholder="Tìm thuốc, đơn vị" />
            <select id="expiryFilter" class="form-select">
                <option value="all">Tất cả</option>
                <option value="expired">Đã hết hạn</option>
                <option value="urgent">Trong 30 ngày</option>
                <option value="watch">Theo dõi</option>
            </select>
        </div>
    </div>
    <div class="alert-card-grid">
    @foreach (var medicine in Model)
    {
        var days = (medicine.ExpiryDate.Date - DateTime.Today).Days;
        var state = days < 0 ? "expired" : days <= 30 ? "urgent" : "watch";
        var badge = days < 0 ? "badge-critical" : days <= 30 ? "badge-hot" : "badge-warn";
        var title = days < 0 ? "Đã hết hạn" : days <= 30 ? "Cần xử lý" : "Theo dõi";
        <article class="alert-card stock-risk-card @(state == "expired" ? "is-critical" : state == "urgent" ? "is-low" : "is-expiring")"
                 data-expiry-row data-state="@state" data-search="@($"{medicine.Name} {medicine.Unit}")">
            <div class="risk-card-head">
                <strong>@medicine.Name</strong>
                <span class="@badge">@title</span>
            </div>
            <dl>
                <div><dt>Tồn</dt><dd>@medicine.QuantityInStock @medicine.Unit</dd></div>
                <div><dt>HSD</dt><dd>@medicine.ExpiryDate.ToString("dd/MM/yyyy")</dd></div>
            </dl>
            <footer>
                <span>@(days < 0 ? $"Quá hạn {Math.Abs(days)} ngày" : $"Còn {days} ngày")</span>
                <small>@(days < 0 ? "Khóa cấp phát và lập biên bản xử lý" : days <= 30 ? "Ưu tiên xuất trước hoặc trả nhà cung cấp" : "Đưa vào danh sách theo dõi")</small>
            </footer>
        </article>
    }
    </div>
</section>
