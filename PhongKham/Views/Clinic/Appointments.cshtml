@model List<Appointment>
@{
    ViewData["Title"] = "Lịch hẹn";
    var patients = ViewBag.Patients as List<Patient> ?? [];
    var doctors = ViewBag.Doctors as List<Doctor> ?? [];
    var statusOptions = ViewBag.StatusOptions as string[] ?? [];
    var scheduleSuggestions = ViewBag.ScheduleSuggestions as List<global::PhongKham.Services.ScheduleSuggestion> ?? [];
    var appointmentPriorities = ViewBag.AppointmentPriorities as List<global::PhongKham.Services.AppointmentPriority> ?? [];
    var medicalRecordMap = ViewBag.MedicalRecordMap as Dictionary<int, int> ?? new Dictionary<int, int>();
    var prescriptionMap = ViewBag.PrescriptionMap as Dictionary<int, int> ?? new Dictionary<int, int>();
    var isPatient = User.IsInRole("BenhNhan");
    var isDoctor = User.IsInRole("BacSi");
    var isAdmin = User.IsInRole("Admin");
}

@if (!isDoctor)
{
    <div class="panel">
        <div class="panel-head">
            <div>
                <h2>@(isPatient ? "Đặt lịch khám" : "Tạo lịch hẹn mới")</h2>
            </div>
        </div>
        <form asp-action="AddAppointment" method="post" class="form-grid">
            @Html.AntiForgeryToken()
            @if (isPatient)
            {
                <input type="hidden" name="PatientId" value="@patients.FirstOrDefault()?.Id" />
            }
            else
            {
                <select name="PatientId" class="form-select">
                    @foreach (var patient in patients)
                    {
                        <option value="@patient.Id">@patient.FullName</option>
                    }
                </select>
            }

            <select name="DoctorId" class="form-select">
                @foreach (var doctor in doctors)
                {
                    <option value="@doctor.Id">@doctor.FullName - @doctor.Specialty</option>
                }
            </select>

            <input name="AppointmentTime" type="datetime-local" class="form-control" />

            @if (isAdmin)
            {
                <input name="Fee" type="number" class="form-control" placeholder="Phí khám" value="150000" />
                <select name="Status" class="form-select">
                    @foreach (var status in new[] { "Đã đặt lịch", "Đã xác nhận", "Đang chờ", "Đang khám", "Hoàn tất", "Hủy" })
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            }

            <input name="Reason" class="form-control wide" placeholder="Lý do khám" />
            <button class="btn btn-primary">@(isPatient ? "Gửi lịch hẹn" : "Lưu lịch hẹn")</button>
        </form>
    </div>
}

@if (isAdmin)
{
    <section class="panel algorithm-panel">
        <div class="panel-head">
            <div>
                <h2>Thuật toán gợi ý xếp lịch</h2>
                <p>Greedy scoring + hàng đợi ưu tiên theo tải bác sĩ, ngày và khung giờ còn trống.</p>
            </div>
        </div>
        <div class="algorithm-list">
            @foreach (var suggestion in scheduleSuggestions)
            {
                <div class="algorithm-row">
                    <span class="algorithm-score">@suggestion.Score</span>
                    <div>
                        <strong>@suggestion.Doctor.FullName</strong>
                        <small>@suggestion.Slot.ToString("dd/MM/yyyy HH:mm") · tải ngày @suggestion.DoctorLoad lịch · @suggestion.Reason</small>
                    </div>
                </div>
            }
            @if (!scheduleSuggestions.Any())
            {
                <p class="text-muted">Chưa có dữ liệu gợi ý lịch.</p>
            }
        </div>
    </section>
}

@if (isDoctor)
{
    <section class="panel algorithm-panel doctor-priority-panel">
        <div class="panel-head">
            <div>
                <h2>Lịch khám ưu tiên</h2>
                <p>Thuật toán chấm điểm theo lịch trong ngày, ca sắp đến lượt, trạng thái chờ xử lý và triệu chứng cần chú ý.</p>
            </div>
        </div>
        <div class="algorithm-list">
            @foreach (var priority in appointmentPriorities)
            {
                var appointment = priority.Appointment;
                medicalRecordMap.TryGetValue(appointment.Id, out var priorityRecordId);
                prescriptionMap.TryGetValue(appointment.Id, out var priorityPrescriptionId);
                <div class="algorithm-row priority-row">
                    <span class="algorithm-score">@priority.Score</span>
                    <div class="priority-main">
                        <strong>@appointment.Patient?.FullName</strong>
                        <small>@appointment.AppointmentTime.ToString("dd/MM/yyyy HH:mm") · @appointment.Reason · @priority.Reason</small>
                    </div>
                    <div class="priority-actions">
                        <a class="btn btn-sm btn-primary" asp-action="MedicalRecords" asp-route-appointmentId="@appointment.Id">
                            @(priorityRecordId > 0 ? "Mở bệnh án" : "Tạo bệnh án")
                        </a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Prescriptions" asp-route-appointmentId="@appointment.Id">
                            @(priorityPrescriptionId > 0 ? "Mở đơn thuốc" : "Kê đơn")
                        </a>
                    </div>
                </div>
            }
            @if (!appointmentPriorities.Any())
            {
                <p class="text-muted">Hiện chưa có lịch cần ưu tiên.</p>
            }
        </div>
    </section>
}

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>@(isDoctor ? "Lịch khám được giao" : isPatient ? "Lịch hẹn của tôi" : "Danh sách lịch hẹn")</h2>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Bệnh nhân</th>
                    <th>Bác sĩ</th>
                    <th>Lý do</th>
                    <th>Phí</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                medicalRecordMap.TryGetValue(item.Id, out var medicalRecordId);
                prescriptionMap.TryGetValue(item.Id, out var prescriptionId);
                var normalizedStatus = (item.Status ?? "").Trim().ToLowerInvariant();
                var nextDoctorStatuses = normalizedStatus.Contains("hoàn tất") || normalizedStatus.Contains("hoan tat")
                    || normalizedStatus.Contains("hủy") || normalizedStatus.Contains("huy")
                        ? Array.Empty<string>()
                        : normalizedStatus.Contains("đang khám") || normalizedStatus.Contains("dang kham")
                            ? new[] { "Hoàn tất" }
                            : new[] { "Đang khám" };
                <tr>
                    <td>@item.AppointmentTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <strong>@item.Patient?.FullName</strong>
                    </td>
                    <td>@item.Doctor?.FullName</td>
                    <td>@item.Reason</td>
                    <td>@item.Fee.ToString("N0") &#273;</td>
                    <td>
                        <span class="badge badge-soft">@item.Status</span>
                    </td>
                    <td>
                        @if (isDoctor)
                        {
                            <div class="d-flex flex-column gap-2">
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var status in nextDoctorStatuses)
                                    {
                                        if (!string.Equals(item.Status, status, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form asp-action="UpdateAppointmentStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="status" value="@status" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary">@status</button>
                                            </form>
                                        }
                                    }
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <a class="btn btn-sm btn-primary" asp-action="MedicalRecords" asp-route-appointmentId="@item.Id">
                                        @(medicalRecordId > 0 ? "Mở bệnh án" : "Tạo bệnh án")
                                    </a>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Prescriptions" asp-route-appointmentId="@item.Id">
                                        @(prescriptionId > 0 ? "Mở đơn thuốc" : "Kê đơn")
                                    </a>
                                </div>
                            </div>
                        }
                        else if (isAdmin)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
