@model List<UserAccount>
@{ ViewData["Title"] = "Tài khoản người dùng"; }
<div class="panel">
    <h2>Thêm tài khoản</h2>
    <form asp-action="AddUser" method="post" class="form-grid">
        <input name="UserName" class="form-control" placeholder="Tên đăng nhập" required />
        <input name="DisplayName" class="form-control" placeholder="Tên hiển thị" />
        <select name="Role" class="form-select"><option>Quản trị</option><option>Bác sĩ</option><option>Dược sĩ</option><option>Kế toán</option></select>
        <select name="IsActive" class="form-select"><option value="true">Đang kích hoạt</option><option value="false">Tạm khóa</option></select>
        <button class="btn btn-primary">Lưu tài khoản</button>
    </form>
</div>
<div class="panel"><h2>Danh sách tài khoản</h2><table class="table"><thead><tr><th>Đăng nhập</th><th>Tên hiển thị</th><th>Vai trò</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var x in Model){<tr><td>@x.UserName</td><td>@x.DisplayName</td><td>@x.Role</td><td>@(x.IsActive ? "Đang kích hoạt" : "Tạm khóa")</td></tr>}</tbody></table></div>
