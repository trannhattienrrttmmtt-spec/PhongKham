@model List<Patient>
@{
    ViewData["Title"] = "Hồ sơ bệnh nhân";
}
<div class="page-title">
    <div>
        <h1>Hồ sơ bệnh nhân</h1>
        <div class="text-muted">Tiếp nhận, tra cứu và cập nhật thông tin hành chính của bệnh nhân.</div>
    </div>
</div>
<div class="panel compact-panel">
    <form asp-action="Patients" method="get" class="admin-filter-bar">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm họ tên, điện thoại, BHYT hoặc địa chỉ..." />
        <select name="gender" class="form-select">
            <option value="">Tất cả giới tính</option>
            <option value="Nam" selected="@(ViewBag.Gender == "Nam")">Nam</option>
            <option value="Nữ" selected="@(ViewBag.Gender == "Nữ")">Nữ</option>
        </select>
        <button class="btn btn-primary">Tìm kiếm</button>
        <a asp-action="Patients" class="btn btn-outline-primary">Xóa lọc</a>
    </form>
</div>
<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Thêm bệnh nhân</h2>
            <p>Nhập thông tin cơ bản để tạo hồ sơ tiếp nhận.</p>
        </div>
    </div>
    <form asp-action="AddPatient" method="post" class="form-grid">
        <input name="FullName" class="form-control" placeholder="Họ tên" required />
        <select name="Gender" class="form-select"><option>Nam</option><option>Nữ</option></select>
        <input name="DateOfBirth" type="date" class="form-control" />
        <input name="Phone" class="form-control" placeholder="Điện thoại" />
        <input name="InsuranceCode" class="form-control" placeholder="Ma BHYT" />
        <input name="Address" class="form-control wide" placeholder="Địa chỉ" />
        <button class="btn btn-primary">Lưu bệnh nhân</button>
    </form>
</div>
<partial name="_PatientsTable" model="Model" />
