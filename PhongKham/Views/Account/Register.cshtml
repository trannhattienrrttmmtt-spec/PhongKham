@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="auth-split-layout">
    <div class="auth-visual-side">
        <a class="auth-visual-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark"><i class="bi bi-hospital"></i></span>
            <span>An Tam Clinic</span>
        </a>
        <div class="auth-visual-quote">
            <h2>Đăng ký trực tuyến,<br>Nhận lịch nhanh chóng.</h2>
            <p>Tạo tài khoản để đặt lịch hẹn với bác sĩ chuyên khoa, nhận thông báo nhắc lịch tự động và tra cứu hồ sơ sức khỏe trực tuyến.</p>
        </div>
        <div class="auth-visual-footer">
            © 2026 An Tâm Clinic. Bảo lưu mọi quyền.
        </div>
    </div>
    
    <div class="auth-form-side">
        <div class="auth-form-container" style="max-width: 500px;">
            <span class="eyebrow">Đăng ký khám bệnh</span>
            <h1>Tạo tài khoản mới</h1>
            <p>Nhập thông tin cơ bản để thiết lập hồ sơ bệnh án cá nhân của bạn.</p>

            <form asp-action="Register" method="post" class="form-grid auth-register-form">
                <div asp-validation-summary="ModelOnly" class="text-danger wide"></div>
                
                <div class="auth-input-group span-2" style="grid-column: span 2; margin-bottom: 20px;">
                    <input asp-for="FullName" class="form-control" placeholder="Họ tên đầy đủ" autocomplete="name" />
                    <i class="bi bi-person"></i>
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                
                <div class="auth-input-group" style="margin-bottom: 20px;">
                    <input asp-for="Email" class="form-control" placeholder="Địa chỉ email" autocomplete="email" />
                    <i class="bi bi-envelope"></i>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                
                <div class="auth-input-group" style="margin-bottom: 20px;">
                    <input asp-for="Phone" class="form-control" placeholder="Số điện thoại" autocomplete="tel" />
                    <i class="bi bi-telephone"></i>
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                
                <div class="auth-input-group" style="margin-bottom: 20px;">
                    <input asp-for="DateOfBirth" type="date" class="form-control" placeholder="Ngày sinh" />
                    <i class="bi bi-calendar-event"></i>
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
                
                <div class="auth-input-group" style="margin-bottom: 20px;">
                    <select asp-for="Gender" class="form-select" style="padding-left: 48px;">
                        <option>Nam</option>
                        <option>Nữ</option>
                        <option value="Khac">Khác</option>
                    </select>
                    <i class="bi bi-gender-ambiguous"></i>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>
                
                <div class="auth-input-group span-2" style="grid-column: span 2; margin-bottom: 20px;">
                    <input asp-for="Address" class="form-control" placeholder="Địa chỉ thường trú" autocomplete="street-address" />
                    <i class="bi bi-geo-alt"></i>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                
                <div class="auth-input-group" style="margin-bottom: 20px;">
                    <input asp-for="Password" class="form-control" placeholder="Mật khẩu" autocomplete="new-password" />
                    <i class="bi bi-lock"></i>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                
                <div class="auth-input-group" style="margin-bottom: 20px;">
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                    <i class="bi bi-lock-check"></i>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                
                <div class="wide" style="grid-column: span 2;">
                    <button class="btn btn-primary w-100 mb-3">Đăng ký tài khoản</button>
                </div>
            </form>
            
            <div class="auth-switch">
                Đã có tài khoản? 
                <a asp-controller="Account" asp-action="Login">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
