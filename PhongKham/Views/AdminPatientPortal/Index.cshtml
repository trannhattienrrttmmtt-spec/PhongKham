@model AdminPatientPortalViewModel
@{
    ViewData["Title"] = "Cổng bệnh nhân";
    var patientMessages = Model.ChatMessages.Where(x => x.Action == "PatientMessage").ToList();
}

@if (TempData["PortalSuccess"] is string success)
{
    <div class="portal-toast success">@success</div>
}
@if (TempData["PortalError"] is string error)
{
    <div class="portal-toast error">@error</div>
}

<div class="page-title">
    <div>
        <span class="eyebrow">Quản trị liên kết bệnh nhân</span>
        <h1>Cổng bệnh nhân</h1>
        <div class="text-muted">Xác nhận lịch khám, quản lý thanh toán, gửi thông báo và trả lời chat.</div>
    </div>
</div>

<div class="metric-grid">
    <div class="metric accent-teal"><span>Lịch chờ xử lý</span><strong>@Model.Appointments.Count(x => x.Status is "Đã đặt lịch" or "Đang chờ")</strong><small>Cần xác nhận hoặc điều phối</small></div>
    <div class="metric accent-green"><span>Hóa đơn đã thanh toán</span><strong>@Model.Invoices.Count(x => x.PaymentStatus == "Paid")</strong><small>Giao dịch bệnh nhân</small></div>
    <div class="metric accent-blue"><span>Tin nhắn bệnh nhân</span><strong>@patientMessages.Count</strong><small>Trao đổi từ cổng bệnh nhân</small></div>
    <div class="metric accent-amber"><span>Thông báo đã gửi</span><strong>@Model.Notifications.Count</strong><small>Cập nhật tới bệnh nhân</small></div>
</div>

<section class="panel">
    <div class="panel-head"><div><h2>Lịch khám từ bệnh nhân</h2><p>Mọi lịch bệnh nhân đặt đều xuất hiện tại đây và trong màn hình Lịch hẹn.</p></div></div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Mã</th><th>Ngày giờ</th><th>Bệnh nhân</th><th>Bác sĩ</th><th>Triệu chứng</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Appointments)
            {
                <tr>
                    <td><strong>LH-@item.Id.ToString("D5")</strong></td>
                    <td>@item.AppointmentTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Patient?.FullName</td>
                    <td>@item.Doctor?.FullName</td>
                    <td>@item.Reason</td>
                    <td><span class="badge badge-soft">@item.Status</span></td>
                    <td>
                        <form asp-action="UpdateAppointmentStatus" method="post" class="admin-inline-form">
                            <input type="hidden" name="id" value="@item.Id" />
                            <select name="status" class="form-select form-select-sm">
                                @foreach (var status in new[] { "Đã đặt lịch", "Đã xác nhận", "Đang chờ", "Hoàn tất", "Đã hủy" })
                                {
                                    <option selected="@(status == item.Status)">@status</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-primary">Lưu</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<div class="admin-portal-grid">
    <section class="panel admin-chat-panel" id="admin-chat">
        <div class="panel-head"><div><h2>Chat với bệnh nhân</h2><p>Chọn bệnh nhân để xem và trả lời toàn bộ hội thoại.</p></div></div>
        @if (Model.SelectedPatientUser is not null)
        {
            var selectedUser = Model.SelectedPatientUser;
            var selectedMessages = Model.ChatMessages.Where(x => x.UserId == selectedUser.Id).ToList();
            <div class="admin-chat-shell">
                <aside class="admin-conversation-list">
                    <div class="admin-chat-search"><input class="form-control" placeholder="Tìm bệnh nhân..." data-admin-chat-search /></div>
                    @foreach (var user in Model.PatientUsers)
                    {
                        var lastMessage = Model.ChatMessages.LastOrDefault(x => x.UserId == user.Id);
                        var preview = lastMessage?.Description.Split('\n', 2)[0];
                        <a class="admin-conversation @(user.Id == selectedUser.Id ? "active" : "")"
                           asp-action="Index" asp-route-selectedUserId="@user.Id" asp-fragment="admin-chat"
                           data-admin-conversation data-search-text="@($"{user.FullName} {user.Email}".ToLowerInvariant())">
                            <span class="chat-avatar">@user.FullName.Trim().Split(' ').Last()[0]</span>
                            <span><strong>@user.FullName</strong><small>@(string.IsNullOrWhiteSpace(preview) ? "Chưa có tin nhắn" : preview)</small></span>
                            <time>@(lastMessage?.CreatedAt.ToString("HH:mm") ?? "")</time>
                        </a>
                    }
                </aside>
                <section class="admin-chat-room">
                    <header class="admin-chat-room-head">
                        <span class="chat-avatar">@selectedUser.FullName.Trim().Split(' ').Last()[0]</span>
                        <div><strong>@selectedUser.FullName</strong><small>@selectedUser.Email · Hội thoại bệnh nhân</small></div>
                    </header>
                    <div class="admin-thread-messages admin-thread-full" data-admin-chat-messages>
                        @if (selectedMessages.Any())
                        {
                            @foreach (var chat in selectedMessages)
                            {
                                var parts = chat.Description.Split('\n', 2);
                                var isAdmin = chat.Action == "AdminReply";
                                <div class="@(isAdmin ? "admin-message" : "patient-message")">
                                    @if (!string.IsNullOrWhiteSpace(parts[0]) && !parts[0].StartsWith("/uploads/"))
                                    {
                                        <span>@parts[0]</span>
                                    }
                                    @if (parts.Length > 1 && parts[1].StartsWith("/uploads/"))
                                    {
                                        <img class="chat-image" src="@parts[1]" alt="Ảnh trong cuộc trò chuyện" />
                                    }
                                    else if (parts[0].StartsWith("/uploads/"))
                                    {
                                        <img class="chat-image" src="@parts[0]" alt="Ảnh trong cuộc trò chuyện" />
                                    }
                                    <small>@(isAdmin ? "Phòng khám" : selectedUser.FullName) · @chat.CreatedAt.ToString("dd/MM HH:mm")</small>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="admin-chat-empty"><strong>Chưa có tin nhắn</strong><span>Gửi lời chào để bắt đầu hỗ trợ bệnh nhân.</span></div>
                        }
                    </div>
                    <form asp-action="ReplyChat" method="post" enctype="multipart/form-data" class="admin-chat-composer">
                        <input type="hidden" name="userId" value="@selectedUser.Id" />
                        <label class="chat-upload" title="Gửi hình ảnh">＋<input type="file" name="image" accept="image/png,image/jpeg,image/webp" hidden /></label>
                        <input name="message" class="form-control" placeholder="Nhập tin nhắn cho @selectedUser.FullName..." />
                        <button class="btn btn-primary">Gửi</button>
                    </form>
                </section>
            </div>
        }
        else
        {
            <p class="text-muted">Chưa có tài khoản bệnh nhân để trò chuyện.</p>
        }
    </section>

    <div>
        <section class="panel">
            <div class="panel-head"><div><h2>Gửi thông báo</h2><p>Gửi trực tiếp tới tài khoản bệnh nhân.</p></div></div>
            <form asp-action="SendNotification" method="post" class="form-grid single-column">
                <select name="userId" class="form-select" required>
                    @foreach (var user in Model.PatientUsers)
                    {
                        <option value="@user.Id">@user.FullName — @user.Email</option>
                    }
                </select>
                <input name="title" class="form-control" placeholder="Tiêu đề thông báo" required />
                <textarea name="message" class="form-control" rows="4" placeholder="Nội dung thông báo..." required></textarea>
                <button class="btn btn-primary">Gửi thông báo</button>
            </form>
        </section>

        <section class="panel">
            <div class="panel-head"><div><h2>Hóa đơn bệnh nhân</h2><p>Theo dõi và điều chỉnh trạng thái thanh toán.</p></div></div>
            <div class="admin-invoice-list">
                @foreach (var invoice in Model.Invoices)
                {
                    <div class="admin-invoice-item">
                        <div><strong>@invoice.InvoiceCode</strong><span>@invoice.Patient?.FullName · @invoice.TotalAmount.ToString("N0") đ</span></div>
                        <form asp-action="UpdateInvoiceStatus" method="post" class="admin-inline-form">
                            <input type="hidden" name="id" value="@invoice.Id" />
                            <select name="status" class="form-select form-select-sm">
                                <option value="Unpaid" selected="@(invoice.PaymentStatus == "Unpaid")">Chờ thanh toán</option>
                                <option value="CashPending" selected="@(invoice.PaymentStatus == "CashPending")">Thanh toán tại quầy</option>
                                <option value="Paid" selected="@(invoice.PaymentStatus == "Paid")">Đã thanh toán</option>
                                <option value="Cancelled" selected="@(invoice.PaymentStatus == "Cancelled")">Đã hủy</option>
                            </select>
                            <button class="btn btn-sm btn-outline-primary">Lưu</button>
                        </form>
                    </div>
                }
                @if (!Model.Invoices.Any())
                {
                    <p class="text-muted">Chưa có hóa đơn bệnh nhân.</p>
                }
            </div>
        </section>
    </div>
</div>
