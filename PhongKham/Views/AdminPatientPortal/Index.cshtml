@model AdminPatientPortalViewModel
@{
    ViewData["Title"] = "Cổng bệnh nhân";
    ViewData["Subtitle"] = "Xác nhận lịch khám, quản lý thanh toán và gửi thông báo.";
}

@if (TempData["PortalSuccess"] is string success)
{
    <div class="portal-toast success">@success</div>
}
@if (TempData["PortalError"] is string error)
{
    <div class="portal-toast error">@error</div>
}



<div class="metric-grid">
    <div class="metric accent-teal"><span>Lịch chờ xử lý</span><strong>@Model.Appointments.Count(x => x.Status is "Đã đặt lịch" or "Đang chờ")</strong><small>Cần xác nhận hoặc điều phối</small></div>
    <div class="metric accent-green"><span>Hóa đơn đã thanh toán</span><strong>@Model.Invoices.Count(x => x.PaymentStatus == "Paid")</strong><small>Giao dịch bệnh nhân</small></div>
    <div class="metric accent-amber"><span>Thông báo đã gửi</span><strong>@Model.Notifications.Count</strong><small>Cập nhật tới bệnh nhân</small></div>
</div>

<section class="panel">
    <div class="panel-head"><div><h2>Lịch khám từ bệnh nhân</h2><p>Mọi lịch bệnh nhân đặt đều xuất hiện tại đây và trong màn hình Lịch hẹn.</p></div></div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Mã</th><th>Ngày giờ</th><th>Bệnh nhân</th><th>Bác sĩ</th><th>Triệu chứng</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Appointments)
            {
                <tr>
                    <td><strong>LH-@item.Id.ToString("D5")</strong></td>
                    <td>@item.AppointmentTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Patient?.FullName</td>
                    <td>@item.Doctor?.FullName</td>
                    <td>@item.Reason</td>
                    <td><span class="badge badge-soft">@item.Status</span></td>
                    <td>
                        <form asp-action="UpdateAppointmentStatus" method="post" class="admin-inline-form">
                            <input type="hidden" name="id" value="@item.Id" />
                            <select name="status" class="form-select form-select-sm">
                                @foreach (var status in new[] { "Đã đặt lịch", "Đã xác nhận", "Đang chờ", "Hoàn tất", "Đã hủy" })
                                {
                                    <option selected="@(status == item.Status)">@status</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-primary">Lưu</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<div class="patient-admin-panels">
    <div>
        <section class="panel">
            <div class="panel-head"><div><h2>Gửi thông báo</h2><p>Gửi trực tiếp tới tài khoản bệnh nhân.</p></div></div>
            <form asp-action="SendNotification" method="post" class="form-grid single-column">
                <select name="userId" class="form-select" required>
                    @foreach (var user in Model.PatientUsers)
                    {
                        <option value="@user.Id">@user.FullName — @user.Email</option>
                    }
                </select>
                <input name="title" class="form-control" placeholder="Tiêu đề thông báo" required />
                <textarea name="message" class="form-control" rows="4" placeholder="Nội dung thông báo..." required></textarea>
                <button class="btn btn-primary">Gửi thông báo</button>
            </form>
        </section>

        <section class="panel">
            <div class="panel-head"><div><h2>Hóa đơn bệnh nhân</h2><p>Theo dõi và điều chỉnh trạng thái thanh toán.</p></div></div>
            <div class="admin-invoice-list">
                @foreach (var invoice in Model.Invoices)
                {
                    <div class="admin-invoice-item">
                        <div><strong>@invoice.InvoiceCode</strong><span>@invoice.Patient?.FullName · @invoice.TotalAmount.ToString("N0") đ</span></div>
                        <form asp-action="UpdateInvoiceStatus" method="post" class="admin-inline-form">
                            <input type="hidden" name="id" value="@invoice.Id" />
                            <select name="status" class="form-select form-select-sm">
                                <option value="Unpaid" selected="@(invoice.PaymentStatus == "Unpaid")">Chờ thanh toán</option>
                                <option value="CashPending" selected="@(invoice.PaymentStatus == "CashPending")">Thanh toán tại quầy</option>
                                <option value="Paid" selected="@(invoice.PaymentStatus == "Paid")">Đã thanh toán</option>
                                <option value="Cancelled" selected="@(invoice.PaymentStatus == "Cancelled")">Đã hủy</option>
                            </select>
                            <button class="btn btn-sm btn-outline-primary">Lưu</button>
                        </form>
                    </div>
                }
                @if (!Model.Invoices.Any())
                {
                    <p class="text-muted">Chưa có hóa đơn bệnh nhân.</p>
                }
            </div>
        </section>
    </div>
</div>
